# Frontend: omit to run entirely in demo mode.
VITE_HERMES_API_URL=http://localhost:8787

# Backend
HERMES_API_PORT=8787
HERMES_BIND_HOST=127.0.0.1
HERMES_ALLOWED_ORIGIN=http://localhost:8080
HERMES_DB_PATH=backend/data/hermes.sqlite
HERMES_SESSION_HOURS=12
HERMES_SEED=true
NODE_ENV=development

# Rate limiting local (janela em milissegundos)
HERMES_RATE_LIMIT_WINDOW_MS=60000
HERMES_GENERAL_RATE_LIMIT_MAX=300
HERMES_REGISTER_RATE_LIMIT_MAX=3
HERMES_LOGIN_RATE_LIMIT_MAX=5
HERMES_PAIRING_TOKEN_RATE_LIMIT_MAX=10
HERMES_PAIRING_CLAIM_RATE_LIMIT_MAX=10
